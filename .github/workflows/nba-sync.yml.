name: NBA sync

# Posts NBA slates, injury updates and box scores to Firestore.
# Times are UTC: every 30 minutes from 6 PM to 3:30 AM US Eastern for live scores,
# plus 9 AM, 1 PM and 4 PM Eastern for morning results and injury updates.
on:
  schedule:
    - cron: "*/30 22,23,0-7 * * *"
    - cron: "0 13,17,20 * * *"
  workflow_dispatch: {}

concurrency:
  group: nba-sync
  cancel-in-progress: false

jobs:
  sync:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        working-directory: sync
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm install --no-audit --no-fund
      - run: node nba-sync.mjs
        env:
          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
