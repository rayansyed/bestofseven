rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function seriesDoc(sid) { return get(/databases/$(database)/documents/series/$(sid)).data; }

    // NBA data. Only the sync writes it, with admin credentials that skip these rules.
    match /days/{date} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/{doc} {
      allow read, write: if false;
    }

    match /series/{sid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.seats[0] == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // The owner may rename teams; any signed-in friend with the link may take the open seat.
      allow update: if signedIn() && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teams']))
        || (resource.data.seats[1] == null
          && request.resource.data.seats[0] == resource.data.seats[0]
          && request.resource.data.seats[1] == request.auth.uid
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'teams', 'members']))
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Lineups are <date>_<uid>, or <date>_cpu for the computer (written by the series owner).
      // Writes are refused once the slate's first game has tipped off.
      match /lineups/{lid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.date is string
          && request.time.toMillis() < get(/databases/$(database)/documents/days/$(request.resource.data.date)).data.lockMs
          && (
            (lid == request.resource.data.date + '_' + request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.auth.uid in seriesDoc(sid).seats)
            || (lid == request.resource.data.date + '_cpu'
              && seriesDoc(sid).owner == request.auth.uid
              && seriesDoc(sid).seats[1] == 'cpu')
          );
        allow delete: if false;
      }
    }
  }
}
