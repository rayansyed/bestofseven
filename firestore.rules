rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.size() >= 3 && n.size() <= 16 && n.matches('^[A-Za-z0-9_ .-]+$'); }
    // A small square photo made by the page: inline JPEG or WebP only, never SVG or a link.
    function validAvatar(d) {
      return !('avatar' in d) || (d.avatar is string && d.avatar.size() <= 30000
        && d.avatar.matches('^data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+$'));
    }
    function validFeatured(d) { return !('featuredBadge' in d) || (d.featuredBadge is string && d.featuredBadge.size() <= 20); }
    function lockMs(date) { return get(/databases/$(database)/documents/days/$(date)).data.lockMs; }

    // NBA data, groups and results. Only the sync writes these, with admin credentials that skip these rules.
    match /days/{date} {
      allow read: if true;
      allow write: if false;
      match /groups/{gid} {
        allow read: if true;
        allow write: if false;
      }
      // Tonight's 1v1 battles, built by the sync at lock.
      match /matches/{mid} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /meta/{doc} {
      allow read, write: if false;
    }
    // Every player's position, rating and archetype, for the card collection screen.
    match /meta/roster {
      allow read: if true;
    }

    // Public profiles. A player sets their name, picture and featured badge; rank fields are written by the sync.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower', 'avatar', 'featuredBadge'])
        && validAvatar(request.resource.data) && validFeatured(request.resource.data)
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower();
      allow delete: if false;
      // A player's cards. Only the server creates them (the sync and /api/packs), so they can't be forged.
      match /cards/{cid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // One entry per player per night: entries/<date>_<uid>. Editable until the first tip-off.
    // Others see your lineup only through your matchup, which the sync builds after lock.
    match /entries/{eid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && eid == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'date', 'ids', 'captain', 'at'])
        && request.resource.data.ids is list && request.resource.data.ids.size() == 6
        && request.time.toMillis() < lockMs(request.resource.data.date);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && request.time.toMillis() < lockMs(resource.data.date);
    }
  }
}
