rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.size() >= 3 && n.size() <= 16 && n.matches('^[A-Za-z0-9_ .-]+$'); }
    function lockMs(date) { return get(/databases/$(database)/documents/days/$(date)).data.lockMs; }

    // NBA data, groups and results. Only the sync writes these, with admin credentials that skip these rules.
    match /days/{date} {
      allow read: if true;
      allow write: if false;
      match /groups/{gid} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /meta/{doc} {
      allow read, write: if false;
    }

    // Public profiles. A player sets only their display name; rank fields are written by the sync.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower();
      allow delete: if false;
    }

    // One entry per player per night: entries/<date>_<uid>. Editable until the first tip-off.
    // Others see your lineup only through your group, which the sync builds after lock.
    match /entries/{eid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string
        && eid == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'date', 'ids', 'captain', 'at'])
        && request.resource.data.ids is list && request.resource.data.ids.size() == 6
        && request.time.toMillis() < lockMs(request.resource.data.date);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && request.time.toMillis() < lockMs(resource.data.date);
    }
  }
}
